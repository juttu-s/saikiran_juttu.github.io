               /saikiran_juttu.github.io/project/digit-recognition/live_hu8695550706911073452.webp 1200w&#34;
               src=&#34;http://localhost:1313/saikiran_juttu.github.io/saikiran_juttu.github.io/project/digit-recognition/live_hu16096523079256018570.webp&#34;
               width=&#34;580&#34;
